#!/bin/bash
set -euo pipefail

# Install Mailpit email testing server.
# Usage: /usr/local/installs/mailpit

# Download binary via ubi
curl -sSf https://raw.githubusercontent.com/houseabsolute/ubi/master/bootstrap/bootstrap-ubi.sh | sh
ubi --project axllent/mailpit --in /usr/local/bin
rm -f /usr/local/bin/ubi

# Register autostart script
mkdir -p /usr/local/etc/curfew/autostart
cat <<'AUTOSTART' > /usr/local/etc/curfew/autostart/mailpit
#!/bin/bash
exec mailpit
AUTOSTART
chmod +x /usr/local/etc/curfew/autostart/mailpit
