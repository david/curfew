#!/bin/bash
set -euo pipefail

# Install Tailscale.
# Usage: /usr/local/installs/tailscale

export DEBIAN_FRONTEND=noninteractive

add-apt-repo tailscale \
    https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg \
    https://pkgs.tailscale.com/stable/ubuntu noble main

apt-get update
apt-get install -y --no-install-recommends tailscale
apt-get clean
rm -rf /var/lib/apt/lists/*

# Register s6-rc longrun service
mkdir -p /etc/s6-overlay/s6-rc.d/svc-tailscale/dependencies.d
printf "longrun\n" > /etc/s6-overlay/s6-rc.d/svc-tailscale/type
cat <<'RUN' > /etc/s6-overlay/s6-rc.d/svc-tailscale/run
#!/bin/bash
STATE_DIR="/home/app/.local/share/tailscale"
mkdir -p "$STATE_DIR"
exec tailscaled --tun=userspace-networking --statedir="$STATE_DIR"
RUN
chmod +x /etc/s6-overlay/s6-rc.d/svc-tailscale/run
touch /etc/s6-overlay/s6-rc.d/svc-tailscale/dependencies.d/init-config
touch /etc/s6-overlay/s6-rc.d/user/contents.d/svc-tailscale
