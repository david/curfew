#!/bin/bash
set -euo pipefail

# Install Conclave web chat interface for Claude Code.
# Usage: /usr/local/installs/conclave [version]   (root — install binary + autostart script)
#        /usr/local/installs/conclave --user       (app  — install ACP adapter)
# Default version: latest

# --user phase: install the ACP adapter (requires claude + bun/npm as app user)
if [ "${1:-}" = "--user" ]; then
    if ! command -v bun &>/dev/null && ! command -v npm &>/dev/null; then
        sudo /usr/local/installs/bun
    fi

    if command -v bun &>/dev/null; then
        bun install -g @zed-industries/claude-code-acp
    else
        npm install -g @zed-industries/claude-code-acp
    fi
    exit 0
fi

# Root phase: install conclave binary and register autostart
version="${1:-latest}"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# Resolve version tag
if [ "$version" = "latest" ]; then
    version=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/david/conclave/releases/latest" | grep -oP 'v\K[^/]+$')
fi

# Download and extract conclave
url="https://github.com/david/conclave/releases/download/v${version}/conclave-v${version}.zip"
curl -fsSL -o "$tmpdir/conclave.zip" "$url"
unzip -q "$tmpdir/conclave.zip" -d "$tmpdir"
install -m 755 "$tmpdir/conclave-v${version}/conclave" /usr/local/bin/conclave

# Register autostart script
mkdir -p /usr/local/etc/curfew/autostart
cat <<'AUTOSTART' > /usr/local/etc/curfew/autostart/conclave
#!/bin/bash
exec conclave &>/dev/null
AUTOSTART
chmod +x /usr/local/etc/curfew/autostart/conclave
