FROM docker.io/library/ubuntu:24.04

LABEL summary="Curfew – isolated development environment" \
      maintainer="david"

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        # Wayland
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        # Clipboard (via Wayland)
        wl-clipboard \
        # Notifications (via D-Bus)
        libnotify-bin \
        # Fonts
        fonts-liberation \
        fonts-noto-color-emoji \
        fontconfig \
        # Core
        curl \
        wget \
        git \
        ca-certificates \
        bash \
        locales \
        xz-utils \
        gawk \
        gnupg \
        man-db \
        less \
        file \
        sudo \
        unzip \
        tar \
    && locale-gen en_US.UTF-8 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# s6-overlay (process supervisor)
ARG S6_OVERLAY_VERSION=3.2.2.0
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && rm /tmp/s6-overlay-noarch.tar.xz
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp
RUN tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && rm /tmp/s6-overlay-x86_64.tar.xz
ENV S6_KEEP_ENV=1

# Install helpers
COPY ../scripts/add-apt-repo.sh /usr/local/bin/add-apt-repo
COPY ../scripts/installs/ /usr/local/installs/
RUN chmod +x /usr/local/bin/add-apt-repo /usr/local/installs/*

# Chrome
RUN /usr/local/installs/chrome

# CLI tools via ubi
RUN curl -sSf https://raw.githubusercontent.com/houseabsolute/ubi/master/bootstrap/bootstrap-ubi.sh | sh \
    && ubi --project sharkdp/bat --in /usr/local/bin \
    && ubi --project eza-community/eza --in /usr/local/bin \
    && ubi --project atuinsh/atuin --in /usr/local/bin \
    && ubi --project BurntSushi/ripgrep --exe rg --in /usr/local/bin \
    && ubi --project axllent/mailpit --in /usr/local/bin \
    && ubi --project direnv/direnv --in /usr/local/bin \
    && ubi --project starship/starship --in /usr/local/bin \
    && ubi --project cli/cli --exe gh --in /usr/local/bin \
    && ubi --project jesseduffield/lazygit --in /usr/local/bin \
    && ubi --project vercel-labs/agent-browser --in /usr/local/bin \
    && ubi --project steveyegge/beads --exe bd --in /usr/local/bin \
    && rm -f /usr/local/bin/ubi

# ble.sh
RUN curl -L https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz \
    | tar xJf - -C /tmp \
    && bash /tmp/ble-nightly/ble.sh --install /usr/local/share/blesh \
    && rm -rf /tmp/ble-nightly

# Kitty terminfo
COPY ../terminfo/x/xterm-kitty /usr/share/terminfo/x/xterm-kitty

# Command aliases (wrappers that shadow /usr/local/bin)
COPY ../scripts/alias/ /usr/local/alias/
RUN chmod +x /usr/local/alias/*
RUN printf 'PATH="/usr/local/alias:$PATH"\n' \
    >> /etc/bash.bashrc

# s6-rc service definitions and init scripts
COPY ../scripts/s6-rc.d/ /etc/s6-overlay/s6-rc.d/
COPY ../scripts/s6-overlay-scripts/ /etc/s6-overlay/scripts/
RUN chmod +x /etc/s6-overlay/scripts/*

RUN /usr/local/installs/conclave

RUN userdel -r ubuntu \
    && groupadd -g 1000 app \
    && useradd -u 1000 -g 1000 -m -s /bin/bash app \
    && echo 'app ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/app

USER app
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN /usr/local/installs/conclave --user
ENV PATH="/usr/local/alias:/home/app/.local/bin:${PATH}"
ENTRYPOINT ["/init"]
CMD ["sleep", "infinity"]
