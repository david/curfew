#!/bin/bash
set -euo pipefail

BASE_IMAGE="ghcr.io/david/curfew:latest"
CONFIG_DIR="${CURFEW_CONFIG:-$HOME/.config/curfew}"
TREE_DIR="$(pwd)"
PROJECT_NAME="$(basename "$(dirname "$TREE_DIR")" | tr '[:upper:]' '[:lower:]')"
TREE_NAME="$(basename "$TREE_DIR" | tr '[:upper:]' '[:lower:]')"
UNIT_NAME="curfew-${PROJECT_NAME}-${TREE_NAME}"
CONTAINER_NAME="$UNIT_NAME"
QUADLET_DIR="$HOME/.config/containers/systemd"

case "${1:-}" in
    gen)
        shift
        force=false
        installs=()
        ports=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --force) force=true; shift ;;
                -i)
                    [ $# -ge 2 ] || { echo "Missing argument for -i" >&2; exit 1; }
                    installs+=("$2"); shift 2 ;;
                -p)
                    [ $# -ge 2 ] || { echo "Missing argument for -p" >&2; exit 1; }
                    ports+=("$2"); shift 2 ;;
                *) echo "Unknown option: $1" >&2; exit 1 ;;
            esac
        done

        # Check for existing files
        quadlet_files=(
            "$QUADLET_DIR/$UNIT_NAME.volume"
            "$QUADLET_DIR/$UNIT_NAME.build"
            "$QUADLET_DIR/$UNIT_NAME.container"
        )
        if [ "$force" = false ]; then
            existing=()
            for f in "${quadlet_files[@]}"; do
                [ -f "$f" ] && existing+=("$f")
            done
            [ -f "$TREE_DIR/.curfew.dockerfile" ] && existing+=("$TREE_DIR/.curfew.dockerfile")
            if [ ${#existing[@]} -gt 0 ]; then
                echo "Files already exist (use --force to overwrite):" >&2
                printf '  %s\n' "${existing[@]}" >&2
                exit 1
            fi
        fi

        mkdir -p "$QUADLET_DIR"

        # Generate .volume
        cat > "$QUADLET_DIR/$UNIT_NAME.volume" <<EOF
[Volume]
VolumeName=curfew-${PROJECT_NAME}-app-home
EOF

        # Generate .build
        cat > "$QUADLET_DIR/$UNIT_NAME.build" <<EOF
[Build]
ImageTag=localhost/$PROJECT_NAME
File=$TREE_DIR/.curfew.dockerfile
SetWorkingDirectory=$TREE_DIR
Pull=always
EOF

        # Generate .container
        {
            cat <<EOF
[Unit]
Description=Curfew dev environment ($PROJECT_NAME/$TREE_NAME)

[Container]
Image=$UNIT_NAME.build
ContainerName=$CONTAINER_NAME
Exec=sleep infinity
StopSignal=SIGKILL
UserNS=keep-id:uid=1000,gid=1000
SecurityLabelDisable=true
Environment=TERM=${TERM:-xterm-kitty}
Environment=WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
Environment=XDG_RUNTIME_DIR=/run/user/1000
Volume=$UNIT_NAME.volume:/home/app
Volume=$CONFIG_DIR:/etc/curfew/config:ro
Volume=$TREE_DIR:/app
Volume=${XDG_RUNTIME_DIR:-/run/user/1000}/${WAYLAND_DISPLAY:-wayland-0}:/run/user/1000/${WAYLAND_DISPLAY:-wayland-0}
Volume=${XDG_RUNTIME_DIR:-/run/user/1000}/bus:/run/user/1000/bus
EOF
            for port in "${ports[@]}"; do
                echo "PublishPort=$port"
            done
            cat <<EOF

[Service]
Restart=on-failure
TimeoutStopSec=10

[Install]
WantedBy=default.target
EOF
        } > "$QUADLET_DIR/$UNIT_NAME.container"

        # Generate .curfew.dockerfile
        {
            echo "FROM $BASE_IMAGE"
            echo ""
            echo "USER root"
            echo ""
            if [ ${#installs[@]} -gt 0 ]; then
                for spec in "${installs[@]}"; do
                    name="${spec%%:*}"
                    version="${spec#*:}"
                    if [ "$version" = "$spec" ]; then
                        echo "RUN /usr/local/installs/$name"
                    else
                        echo "RUN /usr/local/installs/$name $version"
                    fi
                done
            else
                echo "# Install project tools (available scripts: node, ruby, postgres, bun, tailscale)"
                echo "# RUN /usr/local/installs/node 24"
                echo "# RUN /usr/local/installs/bun"
                echo "# RUN /usr/local/installs/postgres 17"
            fi
            echo ""
            echo "USER app"
        } > "$TREE_DIR/.curfew.dockerfile"

        systemctl --user daemon-reload

        echo "Generated:"
        for f in "${quadlet_files[@]}"; do
            echo "  $f"
        done
        echo "  $TREE_DIR/.curfew.dockerfile"
        echo ""
        echo "Start with:   systemctl --user start $UNIT_NAME"
        echo "Stop with:    systemctl --user stop $UNIT_NAME"
        echo "Logs with:    journalctl --user -u $UNIT_NAME"
        ;;
    run)
        shift
        if [ "$(podman inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" != "true" ]; then
            echo "$CONTAINER_NAME is not running." >&2
            echo "Start it with: systemctl --user start $UNIT_NAME" >&2
            exit 1
        fi
        if [ $# -eq 0 ]; then
            set -- bash
        fi
        tty_flags="-i"
        if [ -t 0 ] && [ -t 1 ]; then
            tty_flags="-it"
        fi
        exec podman exec $tty_flags \
            -e TERM="$TERM" \
            -w /app \
            "$CONTAINER_NAME" \
            bash -lc 'PATH="/usr/local/alias:$PATH" exec "$@"' -- "$@"
        ;;
    *)
        echo "Usage: curfew <gen|run> [args...]" >&2
        echo "" >&2
        echo "  gen [--force] [-i tool[:version]]... [-p host:container]..." >&2
        echo "      Generate quadlet files and .curfew.dockerfile" >&2
        echo "" >&2
        echo "  run [cmd...]" >&2
        echo "      Exec into the running container (default: bash)" >&2
        exit 1
        ;;
esac
