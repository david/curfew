#!/bin/bash
set -euo pipefail

BASE_IMAGE="ghcr.io/david/curfew:latest"
TREE_DIR="$(pwd)"
TREE_NAME="$(basename "$TREE_DIR" | tr '[:upper:]' '[:lower:]')"
PROJECT_DIR="$(dirname "$TREE_DIR")"
CONFIG_DIR="${CURFEW_CONFIG:-$HOME/.config/curfew}"
QUADLET_DIR="$HOME/.config/containers/systemd"
SETTINGS_FILE="$PROJECT_DIR/.curfew.json"

read_name() {
    if [ ! -f "$SETTINGS_FILE" ]; then
        echo "No .curfew.json found in $PROJECT_DIR" >&2
        echo "Run 'curfew quadlet add <name>' first." >&2
        exit 1
    fi
    NAME="$(sed -n 's/.*"name" *: *"\([^"]*\)".*/\1/p' "$SETTINGS_FILE")"
    if [ -z "$NAME" ]; then
        echo "Could not read name from $SETTINGS_FILE" >&2
        exit 1
    fi
}

usage() {
    cat >&2 <<EOF
Usage: curfew <command> [args...]

  quadlet add <name> [--force] [-p host:container]...
      Generate quadlet files and .curfew.json

  quadlet rm
      Remove quadlet files and .curfew.json

  quadlet enable [tree]
      Auto-start a tree on login (default: current dir name)

  quadlet disable [tree]
      Remove auto-start for a tree (default: current dir name)

  start [-a|--autostart]
      Start the current worktree's container

  stop
      Stop the current worktree's container

  rebuild
      Rebuild and restart the current worktree's container

  containerfile gen [--force] [-i tool[:version]]...
      Generate .curfew.containerfile in current directory

  containerfile list
      List available install scripts from the base image

  run [cmd...]
      Exec into the running container (default: bash)
EOF
    exit 1
}

cmd_quadlet_add() {
    # Parse args: first positional is the name
    local name="" force=false
    local ports=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=true; shift ;;
            -p)
                [ $# -ge 2 ] || { echo "Missing argument for -p" >&2; exit 1; }
                ports+=("$2"); shift 2 ;;
            -*)
                echo "Unknown option: $1" >&2; exit 1 ;;
            *)
                if [ -z "$name" ]; then
                    name="$1"; shift
                else
                    echo "Unexpected argument: $1" >&2; exit 1
                fi ;;
        esac
    done

    if [ -z "$name" ]; then
        echo "Usage: curfew quadlet add <name> [--force] [-p host:container]..." >&2
        exit 1
    fi

    if [ ! -f "$TREE_DIR/.curfew.containerfile" ]; then
        echo "No .curfew.containerfile found in $TREE_DIR" >&2
        echo "Run 'curfew containerfile gen' first." >&2
        exit 1
    fi

    local quadlet_files=(
        "$QUADLET_DIR/$name.volume"
        "$QUADLET_DIR/$name@.build"
        "$QUADLET_DIR/$name@.container"
    )

    if [ "$force" = false ]; then
        local existing=()
        for f in "${quadlet_files[@]}"; do
            [ -f "$f" ] && existing+=("$f")
        done
        [ -f "$SETTINGS_FILE" ] && existing+=("$SETTINGS_FILE")
        if [ ${#existing[@]} -gt 0 ]; then
            echo "Files already exist (use --force to overwrite):" >&2
            printf '  %s\n' "${existing[@]}" >&2
            exit 1
        fi
    fi

    mkdir -p "$QUADLET_DIR"

    # Generate .volume
    cat > "$QUADLET_DIR/$name.volume" <<EOF
[Volume]
VolumeName=$name-app-home
EOF

    # Generate @.build (template unit)
    cat > "$QUADLET_DIR/$name@.build" <<EOF
[Build]
ImageTag=localhost/$name-%i
File=$PROJECT_DIR/%i/.curfew.containerfile
SetWorkingDirectory=$PROJECT_DIR/%i
Pull=always

[Service]
TimeoutStartSec=270
EOF

    # Generate @.container (template unit)
    {
        cat <<EOF
[Unit]
Description=Curfew dev environment ($name/%i)

[Container]
Image=$name@.build
ContainerName=$name-%i
StopSignal=SIGTERM
UserNS=keep-id:uid=1000,gid=1000
SecurityLabelDisable=true
Environment=TERM=${TERM:-xterm-kitty}
Environment=WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}
Environment=XDG_RUNTIME_DIR=/run/user/1000
Volume=$name.volume:/home/app
Volume=$CONFIG_DIR:/etc/curfew/config:ro
WorkingDir=/app
Volume=$PROJECT_DIR/%i:/app
Volume=${XDG_RUNTIME_DIR:-/run/user/1000}/${WAYLAND_DISPLAY:-wayland-0}:/run/user/1000/${WAYLAND_DISPLAY:-wayland-0}
Volume=${XDG_RUNTIME_DIR:-/run/user/1000}/bus:/run/user/1000/bus
EOF
        for port in "${ports[@]}"; do
            echo "PublishPort=$port"
        done
        cat <<EOF

[Service]
Restart=on-failure
StartLimitBurst=2
TimeoutStartSec=180
TimeoutStopSec=10
EOF
    } > "$QUADLET_DIR/$name@.container"

    # Write .curfew.json
    printf '{"name": "%s"}\n' "$name" > "$SETTINGS_FILE"

    systemctl --user daemon-reload

    echo "Generated:"
    for f in "${quadlet_files[@]}"; do
        echo "  $f"
    done
    echo "  $SETTINGS_FILE"
    echo ""
    echo "Start with: curfew start"
    echo "Auto-start: curfew quadlet enable"
}

cmd_quadlet_rm() {
    read_name

    local quadlet_files=(
        "$QUADLET_DIR/$NAME.volume"
        "$QUADLET_DIR/$NAME@.build"
        "$QUADLET_DIR/$NAME@.container"
    )

    local removed=()
    for f in "${quadlet_files[@]}"; do
        if [ -f "$f" ]; then
            rm "$f"
            removed+=("$f")
        fi
    done
    rm "$SETTINGS_FILE"
    removed+=("$SETTINGS_FILE")

    systemctl --user daemon-reload

    echo "Removed:"
    for f in "${removed[@]}"; do
        echo "  $f"
    done
}

cmd_quadlet_enable() {
    local tree="${1:-$TREE_NAME}"
    read_name
    local wants_dir="$HOME/.config/systemd/user/default.target.wants"
    local link="$wants_dir/$NAME@$tree.service"
    if [ -L "$link" ]; then
        echo "Already enabled: $NAME@$tree" >&2
        exit 0
    fi
    mkdir -p "$wants_dir"
    ln -s "/run/user/$(id -u)/systemd/generator/$NAME@.service" "$link"
    systemctl --user daemon-reload
    systemctl --user start "$NAME@$tree"
    echo "Enabled $NAME@$tree (started and auto-start on login)"
}

cmd_quadlet_disable() {
    local tree="${1:-$TREE_NAME}"
    read_name
    local link="$HOME/.config/systemd/user/default.target.wants/$NAME@$tree.service"
    if [ ! -L "$link" ]; then
        echo "Not enabled: $NAME@$tree" >&2
        exit 0
    fi
    rm "$link"
    systemctl --user daemon-reload
    echo "Disabled $NAME@$tree"
}

cmd_start() {
    local autostart=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--autostart) autostart=true; shift ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
    done
    read_name
    systemctl --user start "$NAME@$TREE_NAME"
    echo "Started $NAME@$TREE_NAME"
    if [ "$autostart" = true ]; then
        cmd_quadlet_enable "$TREE_NAME"
    fi
}

cmd_stop() {
    read_name
    systemctl --user stop "$NAME@$TREE_NAME"
    echo "Stopped $NAME@$TREE_NAME"
}

cmd_rebuild() {
    read_name
    systemctl --user restart "$NAME@$TREE_NAME"
    echo "Rebuilt $NAME@$TREE_NAME"
}

cmd_containerfile_list() {
    podman run --rm "$BASE_IMAGE" ls /usr/local/installs/
}

cmd_containerfile_gen() {
    local force=false
    local installs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=true; shift ;;
            -i)
                [ $# -ge 2 ] || { echo "Missing argument for -i" >&2; exit 1; }
                installs+=("$2"); shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
    done

    if [ "$force" = false ] && [ -f "$TREE_DIR/.curfew.containerfile" ]; then
        echo "File already exists (use --force to overwrite):" >&2
        echo "  $TREE_DIR/.curfew.containerfile" >&2
        exit 1
    fi

    {
        echo "FROM $BASE_IMAGE"
        echo ""
        echo "USER root"
        echo ""
        if [ ${#installs[@]} -gt 0 ]; then
            for spec in "${installs[@]}"; do
                name="${spec%%:*}"
                version="${spec#*:}"
                if [ "$version" = "$spec" ]; then
                    echo "RUN /usr/local/installs/$name"
                else
                    echo "RUN /usr/local/installs/$name $version"
                fi
            done
        else
            echo "# Install project tools (available scripts: node, ruby, postgres, bun, tailscale)"
            echo "# RUN /usr/local/installs/node 24"
            echo "# RUN /usr/local/installs/bun"
            echo "# RUN /usr/local/installs/postgres 17"
        fi
        echo ""
        echo "USER app"
    } > "$TREE_DIR/.curfew.containerfile"

    echo "Generated:"
    echo "  $TREE_DIR/.curfew.containerfile"
}

cmd_run() {
    read_name
    local container_name="$NAME-$TREE_NAME"

    if [ "$(podman inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null)" != "true" ]; then
        echo "$container_name is not running." >&2
        echo "Start it with: curfew start" >&2
        exit 1
    fi
    if [ $# -eq 0 ]; then
        set -- bash
    fi
    local tty_flags="-i"
    if [ -t 0 ] && [ -t 1 ]; then
        tty_flags="-it"
    fi
    exec podman exec $tty_flags \
        -e TERM="$TERM" \
        -w /app \
        "$container_name" \
        bash -lc 'PATH="/usr/local/alias:$PATH" exec "$@"' -- "$@"
}

# Route commands
case "${1:-}" in
    quadlet)
        shift
        case "${1:-}" in
            add)     shift; cmd_quadlet_add "$@" ;;
            rm)      shift; cmd_quadlet_rm ;;
            enable)  shift; cmd_quadlet_enable "$@" ;;
            disable) shift; cmd_quadlet_disable "$@" ;;
            *)       usage ;;
        esac
        ;;
    containerfile)
        shift
        case "${1:-}" in
            gen)  shift; cmd_containerfile_gen "$@" ;;
            list) shift; cmd_containerfile_list ;;
            *)    usage ;;
        esac
        ;;
    start)
        shift
        cmd_start "$@"
        ;;
    stop)
        shift
        cmd_stop
        ;;
    rebuild)
        shift
        cmd_rebuild
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    *)
        usage
        ;;
esac
